<Window x:Class="MediaTagger.TagLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Library" Height="600" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        FontSize="12.5">
    <DockPanel Margin="16">

        <!-- Page selector -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,12">
            <Button Name="CurrentListPageButton" Content="Current List" Margin="0,0,4,0" Click="ShowCurrentListPage_Click"/>
            <Button Name="AddPageButton" Content="Add Tags" Margin="4,0,4,0" Click="ShowAddPage_Click"/>
            <Button Name="RemovePageButton" Content="Remove Tags" Margin="4,0,0,0" Click="ShowRemovePage_Click"/>
        </UniformGrid>

        <!-- Bottom bar: context-sensitive action button + Close -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Name="ActionButton" Content="Add to Library" Margin="0,0,8,0" Click="ActionButton_Click"/>
            <Button Content="Close" Click="Close_Click"/>
        </StackPanel>

        <!-- All three pages occupy the same Grid cell; only one is Visible at a time. They
             have to share one container like this because DockPanel only gives its remaining
             space to its last child - three separate top-level children here would not lay
             out the way switching "tabs" implies. -->
        <Grid>

        <!-- Current List page: plain read-only listing -->
        <Grid Name="CurrentListPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Name="CurrentListCountText" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <ItemsControl Name="CurrentListItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Name="LibraryEmptyText" Text="The library is empty. Use Add Tags to start one."
                                   Style="{StaticResource Faint}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Add Tags page -->
        <Grid Name="AddPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource Faint}" Margin="0,0,0,10"
                       Text="Tags used in the current folder(s). Check the ones to add to the library - tags already in the library are greyed out."/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <CheckBox Name="AddSelectAllBox" Content="Select All" FontWeight="SemiBold" Margin="0,0,0,8" Click="AddSelectAll_Click"/>
                        <ItemsControl Name="AddPageItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <CheckBox Content="{Binding Tag}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsEnabled}" Click="AddRow_Click"/>
                                        <TextBlock Text="{Binding Note}" Foreground="Gray" FontSize="11"
                                                   Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Name="NoFolderTagsText" Text="No tags found in the current folder(s)."
                                   Style="{StaticResource Faint}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="Or type tags to add (space separated), whether or not they're in the current folder:" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6">
                    <TextBox Name="ManualAddBox" Padding="8,6" BorderThickness="0" Background="Transparent"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Remove Tags page -->
        <Grid Name="RemovePage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource Faint}" Margin="0,0,0,10"
                       Text="Every tag currently in the library. Check the ones to remove - this only affects future autocomplete suggestions, not any file or its existing tags."/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <CheckBox Name="RemoveSelectAllBox" Content="Select All" FontWeight="SemiBold" Margin="0,0,0,8" Click="RemoveSelectAll_Click"/>
                        <ItemsControl Name="RemovePageItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <CheckBox Content="{Binding Tag}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="RemoveRow_Click"/>
                                        <TextBlock Text="{Binding Note}" Foreground="Gray" FontSize="11"
                                                   Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Name="LibraryEmptyForRemoveText" Text="The library is empty - nothing to remove."
                                   Style="{StaticResource Faint}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        </Grid>
    </DockPanel>
</Window>
