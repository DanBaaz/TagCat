<Window x:Class="VideoDedupe.DuplicateFinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TagCat Duplicate Finder"
        Height="780" Width="1180"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontSize="12.5">

    <!-- The status bar - the "what happened" summary and its button - is pinned outside
         the scrollable area entirely, via DockPanel.Dock="Bottom", so it stays visible in the
         ordinary case without needing any scrolling machinery to reach it at all.

         Everything above it (folders, presets, advanced options, results) lives inside a
         ScrollViewer instead, but only actually needs to scroll once Advanced Options grows
         tall enough to squeeze the results area below a usable size - see the MinHeight notes
         on the Grid and on the results row further down. In the ordinary case this behaves
         exactly as it always did: results fill the remaining space, no scrollbar appears, and
         the duplicate list / member list keep scrolling internally the way they already do. -->
    <DockPanel Margin="16">

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12,9" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" TextWrapping="Wrap"
                           Text="Pick a folder and press Scan."/>

                <Button x:Name="DetailsButton" Grid.Column="1" Content="What happened?"
                        Click="OnDetailsClick" Visibility="Collapsed" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- A ScrollViewer always measures its content with infinite available height,
             regardless of that content's own MinHeight - MinHeight only clamps the result
             AFTER measurement, it doesn't feed into it. That's exactly why the internal
             scrollbars went missing: with nothing constraining it, the Grid measured its "*"
             row against infinity, which made it collapse to whatever size the content
             naturally wanted, so ClusterList and the member list just grew instead of
             scrolling - the same list-in-a-ScrollViewer trap encountered before with the
             thumbnail grid over in TagCat, showing up here in a different shape.

             Height (not MinHeight) is what actually feeds into measurement, so this is bound
             to the ScrollViewer's own viewport height instead. In the ordinary case that gives
             the Grid a real, finite number to divide "*" against, so row 4 gets a properly
             bounded height and its internal ScrollViewers behave normally again. Grid still
             honours the results row's own MinHeight (below) even if doing so needs more room
             than this Height requests - and since the parent is a ScrollViewer, going over
             that request is exactly what makes it scroll instead of clipping, which is the
             whole reason MinHeight is still worth keeping on that row too. -->
        <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Height="{Binding ActualHeight, ElementName=RootScrollViewer}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Folder selection + media types share row 0 via this stack, so the rest of
             the window's row indices stay as they were. -->
        <StackPanel Grid.Row="0">
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Folders" Margin="0,0,12,0" FontWeight="SemiBold"/>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="6">
                <TextBox x:Name="FolderBox" Padding="8,6" BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Center" Text=""
                         ToolTip="One or more folders, separated by semicolons. Browse adds to this list."/>
            </Border>

            <Button Grid.Column="2" Content="Browse..." Margin="10,0,14,0" Click="OnBrowseClick"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="IncludeSubfolders" Content="Include subfolders"
                          IsChecked="True" VerticalAlignment="Center"/>
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}"
                        Content="&#x2699;" Width="30" Height="26" FontSize="15" Margin="12,0,0,0"
                        ToolTip="Settings" Click="OnSettingsClick"/>
            </StackPanel>
        </Grid>

        <!-- Media types to scan -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Look for duplicate" Margin="0,0,12,0" Style="{StaticResource Muted}"/>
            <CheckBox x:Name="ScanVideos" Content="Videos" IsChecked="True" Margin="0,0,14,0"
                      Checked="OnMediaTypeChanged" Unchecked="OnMediaTypeChanged"/>
            <CheckBox x:Name="ScanImages" Content="Images" Margin="0,0,14,0"
                      Checked="OnMediaTypeChanged" Unchecked="OnMediaTypeChanged"/>
            <!-- IsEnabled toggled in code between Express (checksums work on any file, audio
                 included) and the content-based presets (which still can't fingerprint audio
                 at all). Ticking it and switching presets does not clear the tick - switching
                 back to Express restores it exactly as left. -->
            <CheckBox x:Name="ScanAudio" Content="Audio" Margin="0,0,14,0" IsEnabled="False"
                      ToolTip="Comparing raw bytes works for any file type, so Express can check audio too - the content-based presets still can't."
                      Checked="OnMediaTypeChanged" Unchecked="OnMediaTypeChanged"/>
            <TextBlock x:Name="AudioNoteText" Style="{StaticResource Faint}"
                       Text="(only available in Express scan)"/>
        </StackPanel>
        </StackPanel>

        <!-- Preset selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="How thorough should the scan be?" Style="{StaticResource SectionHeading}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Leftmost: a checksum is either an exact match or it isn't, so Express is
                     the most clear-cut of the four rather than a lesser/faster version of the
                     content-based ones next to it. -->
                <RadioButton x:Name="PresetExpress" Grid.Column="0" GroupName="Preset"
                             Style="{StaticResource PresetCard}"
                             Checked="OnPresetChanged">
                    <StackPanel>
                        <TextBlock Text="Express" FontWeight="SemiBold"/>
                        <TextBlock Text="Fastest. Finds byte-for-byte identical copies only."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="PresetQuick" Grid.Column="2" GroupName="Preset"
                             Style="{StaticResource PresetCard}"
                             Checked="OnPresetChanged">
                    <StackPanel>
                        <TextBlock Text="Quick" FontWeight="SemiBold"/>
                        <TextBlock Text="Fast. Finds re-encodes and resolution changes."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="PresetBalanced" Grid.Column="4" GroupName="Preset"
                             Style="{StaticResource PresetCard}" IsChecked="True"
                             Checked="OnPresetChanged">
                    <StackPanel>
                        <TextBlock Text="Balanced" FontWeight="SemiBold"/>
                        <TextBlock Text="Recommended. Also finds light crops and trims."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="PresetThorough" Grid.Column="6" GroupName="Preset"
                             Style="{StaticResource PresetCard}"
                             Checked="OnPresetChanged">
                    <StackPanel>
                        <TextBlock Text="Thorough" FontWeight="SemiBold"/>
                        <TextBlock Text="Slow. Finds heavy crops and short clips too."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>
            </Grid>
        </StackPanel>

        <!-- Advanced options. Content-based (Quick/Balanced/Thorough) and Express share this
             one Expander, swapping which Border is visible - Express has nothing in common
             with sliders about frame sampling, so it gets its own panel entirely rather than
             a few of these controls being greyed out. -->
        <Expander Grid.Row="2" Margin="0,0,0,10" x:Name="AdvancedPanel">
            <Expander.Header>
                <TextBlock x:Name="AdvancedPanelHeaderText" Text="Advanced options"/>
            </Expander.Header>
            <Grid>
            <Border x:Name="ContentAdvancedPanel" Style="{StaticResource Card}" Padding="16" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <CheckBox x:Name="UseAdvanced" Content="Use these settings instead of the preset"
                                  Margin="0,0,0,14" FontWeight="SemiBold"/>

                        <TextBlock Text="Match strictness" Margin="0,0,0,2"/>
                        <TextBlock x:Name="ThresholdLabel" Style="{StaticResource Muted}"
                                   Text="Higher finds more, but with more false matches."/>
                        <Slider x:Name="ThresholdSlider" Minimum="4" Maximum="18" Value="10"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,14"/>

                        <TextBlock Text="Confidence required" Margin="0,0,0,2"/>
                        <TextBlock x:Name="SimilarityLabel" Style="{StaticResource Muted}"
                                   Text="How much of the shorter video must match."/>
                        <Slider x:Name="SimilaritySlider" Minimum="0.5" Maximum="1.0" Value="0.85"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,4,0,14"/>

                        <TextBlock Text="Crop tolerance" Margin="0,0,0,2"/>
                        <TextBlock x:Name="CropLabel" Style="{StaticResource Muted}"
                                   Text="Ignores this much of each edge before comparing."/>
                        <Slider x:Name="CropSlider" Minimum="0" Maximum="0.25" Value="0.06"
                                TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sample a frame every (seconds)" Margin="0,0,0,2"/>
                        <TextBlock x:Name="IntervalLabel" Style="{StaticResource Muted}"
                                   Text="Lower is more accurate but much slower."/>
                        <Slider x:Name="IntervalSlider" Minimum="0.5" Maximum="15" Value="3"
                                TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,4,0,14"/>

                        <CheckBox x:Name="DetectClips" Content="Find short clips cut from longer videos"
                                  IsChecked="True" Margin="0,0,0,10"
                                  Checked="OnAdvancedOptionChanged" Unchecked="OnAdvancedOptionChanged"/>

                        <CheckBox x:Name="DetectLetterbox" Content="Ignore black bars (letterboxing)"
                                  IsChecked="True" Margin="0,0,0,10"
                                  Checked="OnAdvancedOptionChanged" Unchecked="OnAdvancedOptionChanged"/>

                        <CheckBox x:Name="UseCache" Content="Reuse results from previous scans"
                                  IsChecked="True" Margin="0,0,0,10"/>

                        <TextBlock x:Name="CacheDisabledNote" Style="{StaticResource Faint}"
                                   TextWrapping="Wrap" Margin="24,0,0,10" Visibility="Collapsed"
                                   Text="Fingerprint retention is switched off in TagCat's settings, so nothing is cached between scans."/>

                        <CheckBox x:Name="ScanTrash" Content="Include trash / recycle bin folders"
                                  IsChecked="False" Margin="0,0,0,4"
                                  ToolTip="Off by default in every preset. Anything found inside one is flagged in the results."/>
                        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="24,0,0,10"
                                   Text="Covers Windows $Recycle.Bin and macOS .Trashes / .Trash, which external drives collect. Deleted copies otherwise show up as duplicates of files you still want."/>

                        <CheckBox x:Name="IncludeExcludedContent" Content="Include files and folders normally excluded"
                                  IsChecked="False" Margin="0,0,0,4"
                                  ToolTip="Off by default. Bypasses the excluded folders and files list from Settings, for just this scan."/>
                        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="24,0,0,10"
                                   Text="The excluded folders and files list is reviewed and edited in Settings."/>

                        <Border Background="{StaticResource WindowBackgroundBrush}" CornerRadius="6"
                                Padding="10,8" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap"
                                       Text="Changing the frame interval, crop tolerance or black bar setting means every video has to be re-examined from scratch on the next scan."/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ExpressOptionsPanel" Style="{StaticResource Card}" Padding="16" Margin="0,8,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="Express reads every file's actual bytes and checksums them, so a match here means the files are genuinely identical - nothing below is required for that to work."/>

                    <TextBlock Text="Additional restrictions (optional)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Off by default. Ticking one only narrows an already-identical match further - two identical files still have to agree on whatever's ticked here to be grouped."/>

                    <CheckBox x:Name="ExpressMatchName" Content="Match File Name"
                              Margin="0,0,0,10" Checked="OnExpressOptionChanged" Unchecked="OnExpressOptionChanged"/>
                    <CheckBox x:Name="ExpressMatchCreated" Content="Match File Created Date/Time"
                              Margin="0,0,0,10" Checked="OnExpressOptionChanged" Unchecked="OnExpressOptionChanged"/>
                    <CheckBox x:Name="ExpressMatchModified" Content="Match File Modified Date/Time"
                              Margin="0,0,0,14" Checked="OnExpressOptionChanged" Unchecked="OnExpressOptionChanged"/>

                    <CheckBox x:Name="IncludeExcludedExpress" Content="Include files and folders normally excluded"
                              IsChecked="False" Margin="0,0,0,4"
                              ToolTip="Off by default. Bypasses the excluded folders and files list from Settings, for just this scan."/>
                    <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="24,0,0,14"
                               Text="The excluded folders and files list is reviewed and edited in Settings."/>

                    <TextBlock Text="File size" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Only files within this range are considered at all. Leave a box empty for no limit on that side."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Min" Width="34" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox x:Name="ExpressSizeMinBox" Width="90" Margin="4,1" FontSize="11" MaxLength="16"
                                 VerticalContentAlignment="Center" TextChanged="OnExpressOptionTextChanged"/>
                        <ComboBox x:Name="ExpressSizeMinUnitCombo" Width="62" SelectedIndex="0"
                                  FontSize="11" SelectionChanged="OnExpressOptionSelectionChanged">
                            <ComboBoxItem Content="KB"/>
                            <ComboBoxItem Content="MB"/>
                            <ComboBoxItem Content="GB"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Max" Width="34" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox x:Name="ExpressSizeMaxBox" Width="90" Margin="4,1" FontSize="11" MaxLength="16"
                                 VerticalContentAlignment="Center" TextChanged="OnExpressOptionTextChanged"/>
                        <ComboBox x:Name="ExpressSizeMaxUnitCombo" Width="62" SelectedIndex="1"
                                  FontSize="11" SelectionChanged="OnExpressOptionSelectionChanged">
                            <ComboBoxItem Content="KB"/>
                            <ComboBoxItem Content="MB"/>
                            <ComboBoxItem Content="GB"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>
        </Expander>

        <!-- Scan controls -->
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ScanButton" Grid.Column="0" Content="Scan" Click="OnScanClick"
                        Style="{StaticResource PrimaryButton}" MinWidth="130"/>

                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="OnCancelClick"
                        IsEnabled="False"/>

                <ProgressBar x:Name="Progress" Grid.Column="2" Height="8" Margin="12,0,14,0"
                             Minimum="0" Maximum="1" VerticalAlignment="Center"
                             Foreground="{StaticResource AccentBrush}"/>

                <TextBlock x:Name="ProgressText" Grid.Column="3" Text="Ready" MinWidth="170"
                           TextAlignment="Right" Style="{StaticResource Muted}"/>
            </Grid>

        </StackPanel>

        <!-- Results -->
        <!-- MinHeight is roughly two full member-preview rows (each ~110px including its
             padding and divider) - below that the list stops being usable anyway. This is
             what actually triggers the page-level scrolling above: once Advanced Options
             squeezes this below its floor, the Grid's total needed height exceeds the
             ScrollViewer's viewport and a scrollbar takes over, rather than this area just
             getting quietly squeezed down to nothing. -->
        <Grid Grid.Row="4" MinHeight="230">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cluster list -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sort by" Margin="0,0,8,0" Style="{StaticResource Muted}"/>
                        <ComboBox x:Name="SortBox" Grid.Column="1" SelectedIndex="4"
                                  SelectionChanged="OnSortChanged">
                            <ComboBoxItem Content="Space to reclaim"/>
                            <ComboBoxItem Content="Confidence"/>
                            <ComboBoxItem Content="Group size"/>
                            <ComboBoxItem Content="Duration"/>
                            <ComboBoxItem Content="File name"/>
                        </ComboBox>
                    </Grid>

                    <Separator DockPanel.Dock="Top" Margin="0,0,0,4"/>

                    <!-- A single clickable summary row, styled the same as a found-duplicate
                         entry above it, rather than its own separate scrollable box - clicking
                         it lists every unreadable file in the panel on the right, the same way
                         clicking a duplicate group lists its members there. -->
                    <Border x:Name="FailuresSummaryRow" DockPanel.Dock="Bottom" Visibility="Collapsed"
                            Cursor="Hand" CornerRadius="6" Padding="10,8" Margin="4,6,4,0"
                            MouseLeftButtonUp="OnFailuresSummaryClick">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Could not be read" FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock x:Name="FailuresSummarySubtitle" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="ClusterList" BorderThickness="0" Margin="4" Padding="0"
                             Background="Transparent"
                             SelectionChanged="OnClusterSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="4,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{StaticResource WindowBackgroundBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{StaticResource AccentSoftBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}"
                                                   FontSize="11" Margin="0,3,0,0"
                                                   Visibility="{Binding WarningVisibility}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </DockPanel>
            </Border>

            <!-- Detail panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel Margin="16">

                    <TextBlock x:Name="DetailHeader" DockPanel.Dock="Top"
                               Style="{StaticResource SectionHeading}"
                               Text="Select a group on the left to review it."/>

                    <StackPanel x:Name="ActionBar" DockPanel.Dock="Bottom" Orientation="Horizontal"
                                Margin="0,14,0,0" Visibility="Collapsed">
                        <Button Content="Send ticked to Recycle Bin" Click="OnDeleteClick"
                                Style="{StaticResource DangerButton}" MinWidth="200"/>
                        <Button Content="Tick all but the keeper" Click="OnTickSuggestedClick" MinWidth="160"/>
                        <Button Content="Untick all" Click="OnUntickAllClick"/>
                    </StackPanel>

                    <!-- Both panels share one Grid cell so whichever is visible becomes the
                         DockPanel's fill child - a Bottom/Top-docked sibling placed after this
                         would otherwise wrongly take over as the fill element itself. -->
                    <Grid>
                    <ScrollViewer x:Name="MemberScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MemberList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsTicked, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"/>

                                            <Border Grid.Column="1" Width="150" Height="86"
                                                    Background="{StaticResource WindowBackgroundBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="5" Margin="0,0,14,0">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Button Content="Play" Tag="{Binding FilePath}" Click="OnPlayClick" MinWidth="90"/>
                                                    <Button Content="More Options" Tag="{Binding}" Click="MoreOptionsButton_Click" MinWidth="90" Margin="8,0,0,0">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Open Containing Folder" Click="OpenContainingFolder_MenuClick"/>
                                                                <MenuItem Header="Open Folder in TagCat" Click="OpenInMediaTagger_MenuClick"/>
                                                                <MenuItem Header="Open all Folders in Group" Click="OpenAllFoldersInGroup_MenuClick"/>
                                                                <Separator/>
                                                                <MenuItem Header="Exclude Folder for This Session" Click="ExcludeFolderSession_MenuClick"/>
                                                                <MenuItem Header="Exclude Folder for All Sessions..." Click="ExcludeFolderPermanent_MenuClick"/>
                                                                <MenuItem Header="Exclude File for All Future Sessions..." Click="ExcludeFilePermanent_MenuClick"/>
                                                                <Separator/>
                                                                <MenuItem Header="Copy File Path" Click="CopyFilePath_MenuClick"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Faint}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                <TextBlock Text="{Binding KeeperNote}" Foreground="{StaticResource SuccessBrush}"
                                                           FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"
                                                           Visibility="{Binding KeeperVisibility}"/>
                                                <TextBlock Text="{Binding TrashNote}" Foreground="{StaticResource WarningBrush}"
                                                           FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"
                                                           Visibility="{Binding TrashVisibility}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Shown instead of the member list after clicking the "Could not be
                         read" summary row. Lists every failure at once, laid out the same way
                         MemberList shows a group's members, right down to reusing
                         OnPlayClick/OnOpenFolderClick via the same Tag-binding trick. -->
                    <ScrollViewer x:Name="FailureDetailScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FailureDetailList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Button Content="Play" Tag="{Binding FilePath}" Click="OnPlayClick" MinWidth="90"/>
                                                <Button Content="Open Folder" Tag="{Binding FilePath}" Click="OnOpenFolderClick" MinWidth="90" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Faint}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>

                </DockPanel>
            </Border>
        </Grid>
        </Grid>
        </ScrollViewer>

    </DockPanel>
</Window>
