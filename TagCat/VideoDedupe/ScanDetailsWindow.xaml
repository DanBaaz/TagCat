<Window x:Class="VideoDedupe.ScanDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What happened during the scan"
        Height="560" Width="680"
        MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        FontSize="12.5">
    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top" Text="What happened during the scan"
                   Style="{StaticResource SectionHeading}" Margin="0,0,0,10"/>

        <!-- Shown only when this scan actually hit files it could not read AND ffmpeg is not
             already on the machine - see the code-behind. Docked above the button row so it
             sits directly beneath the report it relates to. -->
        <Border x:Name="FfmpegNotice" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Some files could not be read" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,8"
                           Text="Windows has no decoder for some older or less common video formats - .flv, .vob, .rm, .divx and .ogv among them. Installing ffmpeg gives the Duplicate Finder a fallback for those, and it will be picked up automatically on the next scan. Nothing else needs changing, and it makes no difference to formats that already work."/>
                <TextBlock>
                    <Hyperlink Click="OnGetFfmpegClick">Where to get ffmpeg</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- The log link and Close share this row: the link floats left (it needs no fixed
             width), Close is pinned right, which is what the two-column Grid buys over a
             plain StackPanel here. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                <Hyperlink Click="OnViewLogClick">See the full log.</Hyperlink>
            </TextBlock>
            <Button Grid.Column="1" Content="Close" Click="OnCloseClick" MinWidth="90"/>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="ReportText" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" TextWrapping="NoWrap" AcceptsReturn="True"
                         FontFamily="Consolas" FontSize="12"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
