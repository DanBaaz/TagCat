<Window x:Class="MediaTagger.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="560" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        FontSize="12.5">
    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Done" IsDefault="True" Click="Done_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Expander x:Name="MediaTaggerSection" Margin="0,0,0,14">
                    <Expander.Header><TextBlock Text="TagCat" FontWeight="Bold"/></Expander.Header>
                    <StackPanel Margin="0,8,0,0">

                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeading}"/>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Thumbnail Size" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,2,0,8"
                                           Text="Scales the whole tile, width and height together, so it keeps its shape. Applies straight away."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Name="ThumbnailSizeSlider"
                                            Minimum="60" Maximum="260" TickFrequency="10"
                                            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                            VerticalAlignment="Center"
                                            ValueChanged="ThumbnailSize_ValueChanged"/>
                                    <TextBlock Grid.Column="1" Name="ThumbnailSizeText" Width="86"
                                               TextAlignment="Right" VerticalAlignment="Center"
                                               Style="{StaticResource Muted}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Name="ResetThumbnailButton" Content="Reset to default"
                                            Click="ResetThumbnail_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Performance" Style="{StaticResource SectionHeading}"/>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox Name="VirtualizationBox" Content="Only build tiles that are on screen"
                                          Margin="0,0,0,4" Checked="Virtualization_Changed" Unchecked="Virtualization_Changed"/>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="24,0,0,10"
                                           Text="On by default, and worth leaving on. With it off, every file in the folder gets a tile and a decoded thumbnail built up front and held in memory — fine for a few hundred files, but a library of several thousand becomes slow to open, stutters when scrolling, and can eventually run out of memory. Turn it off only if the file grid misbehaves."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Thumbnail cache" Style="{StaticResource SectionHeading}"/>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Stores generated thumbnails so reopening a folder doesn't mean regenerating every one from scratch. Safe to delete: the next one just takes longer to appear."/>

                                <CheckBox Name="RetainThumbnailsBox" Content="Keep thumbnails between sessions"
                                          Margin="0,0,0,4" Checked="ThumbnailCacheOption_Changed" Unchecked="ThumbnailCacheOption_Changed"/>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="24,0,0,10"
                                           Text="On by default. Off means every thumbnail is regenerated each time it's needed and nothing is cached on disk."/>

                                <CheckBox Name="ClearThumbnailsOnExitBox" Content="Clear thumbnails when the app closes"
                                          Margin="0,0,0,4" Checked="ThumbnailCacheOption_Changed" Unchecked="ThumbnailCacheOption_Changed"/>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="24,0,0,12"
                                           Text="Off by default. Keeps the speed of a cache within a session, but leaves nothing behind afterwards."/>

                                <TextBlock Text="Cache folder" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="6" VerticalAlignment="Center">
                                        <TextBox Name="ThumbnailCacheFolderBox" Padding="8,6" BorderThickness="0"
                                                 Background="Transparent" VerticalContentAlignment="Center"
                                                 TextChanged="ThumbnailCacheFolder_TextChanged"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="Change..." Margin="10,0,0,0"
                                            Click="BrowseThumbnailCacheFolder_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,6,0,10"
                                           Text="Changing this starts a new cache rather than moving the old one; the previous file is left where it was."/>

                                <TextBlock Name="ThumbnailCacheSizeText" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Name="OpenThumbnailCacheFolderButton" Content="Open folder" Click="OpenThumbnailCacheFolder_Click"/>
                                    <Button Name="ClearThumbnailCacheButton" Content="Clear cache"
                                            Style="{StaticResource DangerButton}" Click="ClearThumbnailCache_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Files" Style="{StaticResource SectionHeading}"/>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox Name="ShowHiddenFilesBox" Content="Show hidden files and folders"
                                          Checked="ShowHiddenFiles_Changed" Unchecked="ShowHiddenFiles_Changed"/>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="24,4,0,14"
                                           Text="Off by default, matching File Explorer. Hidden items are usually system clutter rather than anything worth tagging. Applies immediately."/>

                                <TextBlock Text="Double-click or Enter opens a file in:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <RadioButton Name="OpenInViewerRadio" GroupName="OpenMode"
                                             Content="TagCat's viewer" Margin="0,0,0,4"
                                             Checked="OpenMode_Changed"/>
                                <RadioButton Name="OpenInSystemRadio" GroupName="OpenMode"
                                             Content="The system default app" Margin="0,0,0,4"
                                             Checked="OpenMode_Changed"/>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="20,2,0,0"
                                           Text="The right-click menu always offers both, whichever is set here."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Video preview" Style="{StaticResource SectionHeading}"/>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox Name="AutoplayDefaultBox" Content="Autoplay videos when selected" Margin="0,0,0,8"
                                          Checked="PreviewDefault_Changed" Unchecked="PreviewDefault_Changed"/>
                                <CheckBox Name="LoopDefaultBox" Content="Loop videos" Margin="0,0,0,8"
                                          Checked="PreviewDefault_Changed" Unchecked="PreviewDefault_Changed"/>
                                <CheckBox Name="MuteDefaultBox" Content="Start muted" Margin="0,0,0,8"
                                          Checked="PreviewDefault_Changed" Unchecked="PreviewDefault_Changed"/>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="These set what a new session starts with - they don't change autoplay, loop or mute for what's playing right now, which are the checkboxes under the preview itself."/>

                                <CheckBox Name="LimitPreviewToNativeBox" Content="Limit preview size to native resolution"
                                          Checked="LimitPreviewToNative_Changed" Unchecked="LimitPreviewToNative_Changed"/>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="24,4,0,0"
                                           Text="Off by default. On stops the preview stretching a smaller image or video past its actual pixel size, which otherwise can look soft. Applies immediately, right now, not just to future sessions."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Startup Folder" Style="{StaticResource SectionHeading}"/>
                        <Border Style="{StaticResource Card}" Padding="14">
                            <StackPanel>
                                <RadioButton Name="StartPreviousFoldersRadio" GroupName="Startup"
                                             Content="Reopen the folders I had open last time" Margin="0,0,0,10"
                                             Checked="StartupMode_Changed"/>

                                <RadioButton Name="StartDefaultFolderRadio" GroupName="Startup"
                                             Content="Open default folder:" Margin="0,0,0,4"
                                             Checked="StartupMode_Changed"/>
                                <Grid Margin="20,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="6" VerticalAlignment="Center">
                                        <TextBox Name="DefaultFolderBox" Padding="8,6" BorderThickness="0"
                                                 Background="Transparent" VerticalContentAlignment="Center"
                                                 TextChanged="DefaultFolder_TextChanged"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="Browse..." Margin="10,0,0,0"
                                            Click="BrowseDefaultFolder_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="20,6,0,0"
                                           Text="Leave empty to start with nothing loaded. A folder that no longer exists is skipped rather than reported as an error."/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Expander>

                <Expander x:Name="DuplicateFinderSection" Margin="0,0,0,14">
                    <Expander.Header><TextBlock Text="Duplicate Finder" FontWeight="Bold"/></Expander.Header>
                    <StackPanel Margin="0,8,0,0">

                        <TextBlock Text="Behaviour" Style="{StaticResource SectionHeading}"/>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox Name="CloseDedupeOnExitBox" Content="Close Duplicate Finder when TagCat closes"
                                          Margin="0,0,0,12"
                                          Checked="DedupeOption_Changed" Unchecked="DedupeOption_Changed"/>

                                <TextBlock Text="Open Duplicate Finder as:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <RadioButton Name="DedupeSeparateWindowRadio" GroupName="DedupeWindowMode"
                                             Content="A separate window" Margin="0,0,0,4"
                                             Checked="DedupeOption_Changed"/>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="20,0,0,8"
                                           Text="The default. Sits alongside TagCat, so you can carry on tagging while a scan runs."/>
                                <RadioButton Name="DedupePopupRadio" GroupName="DedupeWindowMode"
                                             Content="A popup" Margin="0,0,0,4"
                                             Checked="DedupeOption_Changed"/>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="20,0,0,14"
                                           Text="Stays in front and blocks TagCat until closed."/>

                                <TextBlock Text="Play a duplicate in:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <RadioButton Name="DupesInViewerRadio" GroupName="DupeOpenMode"
                                             Content="TagCat's viewer" Margin="0,0,0,4"
                                             Checked="DedupeOption_Changed"/>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="20,0,0,8"
                                           Text="The default. Scrolling moves between the other files in that same duplicate group, so they can be compared directly."/>
                                <RadioButton Name="DupesInSystemRadio" GroupName="DupeOpenMode"
                                             Content="The system default app" Margin="0,0,0,4"
                                             Checked="DedupeOption_Changed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Excluded from scanning" Style="{StaticResource SectionHeading}"/>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Skipped by every Duplicate Finder scan. Each scan mode's advanced options has its own checkbox to include them anyway, just for that scan."/>

                                <TextBlock Text="Folders" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,4">
                                    <ListBox Name="ExcludedFoldersList" BorderThickness="0" Background="Transparent"
                                             MaxHeight="110" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Content="Add Folder..." Click="AddExcludedFolder_Click"/>
                                    <Button Content="Remove Selected" Margin="8,0,0,0" Click="RemoveExcludedFolder_Click"/>
                                </StackPanel>

                                <TextBlock Text="Files" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,4">
                                    <ListBox Name="ExcludedFilesList" BorderThickness="0" Background="Transparent"
                                             MaxHeight="110" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Add File..." Click="AddExcludedFile_Click"/>
                                    <Button Content="Remove Selected" Margin="8,0,0,0" Click="RemoveExcludedFile_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Fingerprint cache" Style="{StaticResource SectionHeading}"/>
                        <Border Style="{StaticResource Card}" Padding="14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Stores what each video looked like so repeat scans are fast. Safe to delete: the next scan simply rebuilds it, which takes longer."/>

                                <CheckBox Name="RetainFingerprintsBox" Content="Keep fingerprints between scans"
                                          Margin="0,0,0,4" Checked="DedupeOption_Changed" Unchecked="DedupeOption_Changed"/>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="24,0,0,10"
                                           Text="On by default. Off means every scan examines each file from scratch and nothing is cached on disk — slower, but no stored record of what you scanned."/>

                                <CheckBox Name="ClearFingerprintsOnExitBox" Content="Clear fingerprints when the app closes"
                                          Margin="0,0,0,4" Checked="DedupeOption_Changed" Unchecked="DedupeOption_Changed"/>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="24,0,0,12"
                                           Text="Off by default. Keeps the speed of a cache within a session, but leaves nothing behind afterwards."/>

                                <TextBlock Text="Cache folder" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="6" VerticalAlignment="Center">
                                        <TextBox Name="CacheFolderBox" Padding="8,6" BorderThickness="0"
                                                 Background="Transparent" VerticalContentAlignment="Center"
                                                 TextChanged="CacheFolder_TextChanged"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="Change..." Margin="10,0,0,0"
                                            Click="BrowseCacheFolder_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,6,0,10"
                                           Text="The cache grows with the size of the library scanned, so a large one may be better off the system drive. Changing this starts a new cache rather than moving the old one; the previous file is left where it was."/>

                                <TextBlock Name="CacheSizeText" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Name="OpenCacheFolderButton" Content="Open folder" Click="OpenCacheFolder_Click"/>
                                    <Button Name="ClearCacheButton" Content="Clear cache"
                                            Style="{StaticResource DangerButton}" Click="ClearCache_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Expander>

                <TextBlock Name="AboutHeadingText" Text="About" Style="{StaticResource SectionHeading}"/>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap"
                                   Text="Tags are stored in the filename itself, so they travel with the file and need no database."/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Updates" Style="{StaticResource SectionHeading}"/>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <Button Name="CheckUpdatesButton" Content="Check for updates"
                                HorizontalAlignment="Left" Click="CheckUpdates_Click"/>
                        <TextBlock Name="UpdateStatusText" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                        <CheckBox Name="CheckUpdatesOnStartupBox" Content="Check for updates at startup"
                                  Margin="0,10,0,0" Checked="UpdateOption_Changed" Unchecked="UpdateOption_Changed"/>
                        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="24,2,0,0"
                                   Text="Asks GitHub for the latest version number only. Nothing is downloaded or installed automatically."/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Changelogs" Style="{StaticResource SectionHeading}"/>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Name="VersionText" FontWeight="SemiBold"/>
                        <Button Content="View changelog" HorizontalAlignment="Left"
                                Margin="0,6,0,0" Click="Changelog_Click"/>

                        <TextBlock Name="DedupeVersionText" FontWeight="SemiBold" Margin="0,16,0,0"/>
                        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Started as a separate standalone app before being merged in - hence two version numbers."/>
                        <Button Content="View changelog" HorizontalAlignment="Left"
                                Margin="0,6,0,0" Click="DedupeChangelog_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Licence" Style="{StaticResource SectionHeading}"/>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Faint}" Margin="0,0,0,8"
                                   Text="TagCat's own code is MIT licensed - free to use, change and share. It's built on LibVLC and LibVLCSharp, which are LGPL-2.1-or-later, plus some MIT-licensed Microsoft components."/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="View licence" Click="ViewLicence_Click"/>
                            <Button Content="Third-party notices" Margin="8,0,0,0" Click="ViewThirdParty_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
